{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChillDB",
  "version": "0.3.1",
  "identifier": "io.chilldb.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChillDB",
        "width": 1400,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark",
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2MTI1RDE1OTZCQjgyRjUKUldUMWdydVdGVjBTWmg1MlRzQmlTeGFiL1Y0dk9UUjVhby9KOTFkcWNLbFh0Z1gyc1Jkc3dqazIK",
      "endpoints": [
        "https://github.com/amdkholil/ChillDB/releases/latest/download/latest.json"
      ]
    }
  }
}
